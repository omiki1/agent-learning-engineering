# ============ 智谱 GLM 配置 ============
# 模型名称：glm-4.7（关闭思考模式见 model/my_model.py 的 extra_body）
MODEL_NAME=glm-4.7
# 智谱开放平台 API Key
GLM_API_KEY=
# 智谱 OpenAI 兼容接口地址（langchain_openai.ChatOpenAI 需要显式指定）
BASE_URL=https://open.bigmodel.cn/api/paas/v4

# ============ 邮件工具配置（tool/send_email_tool.py） ============
SENDER_EMAIL=
# QQ 邮箱等使用的授权码，不是登录密码
SENDER_EMAIL_PASSWORD=
SMTP_HOST=smtp.qq.com
SMTP_PORT=587

# ============ 天气与搜索工具 ============
# 心知天气 API Key
WEATHER=
# 百度千帆 API Key
BAIDU_KEY=
# 阿里云百炼 DashScope API Key
DASHSCOPE_API_KEY1=

# ============ PostgreSQL ============
POSTGRESQL_URL=postgresql://user:password@localhost:5432/postgres?sslmode=disable

# ============ MySQL（tool/mysql_tool.py） ============
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=agent_test

# ============ Redis（redis数据库操作示例 专用） ============
# 服务：Docker 容器 redis-local（127.0.0.1:6379）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=1
# 服务端密码（对应 redis.conf 的 requirepass）
REDIS_PASSWORD=

# ============ 向量库与记忆窗口 ============
CHROMA_PATH=./chroma
# 窗口记忆消息次数，生产环境 40 次
WINDOW_MEMORY_ROUNDS=8
# 窗口记忆过期时间（秒），生产环境一天
WINDOW_MEMORY_TIME=86400
